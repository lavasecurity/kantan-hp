---

{ socials.length > 0 && (
  <div class="social-links">
    {socials.map((social) => (
      <a href={social.url} target="_blank" rel="noopener noreferrer">
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          {paths[social.name.toLowerCase()] ? (
            <path d={paths[social.name.toLowerCase()]} />
          ) : (
            <path d="M14 3h7v7h-2V6.4L10.4 15 9 13.6 17.6 5H14V3ZM5 5h6v2H5v12h12v-6h2v8H3V5h2Z" />
          )}
        </svg>
        <span>{social.name}</span>
      </a>
    ))}
  </div>
)}
